+    assert_eq!(apply_global_alpha(pixel, 0.5, true), (0.2, 0.1, 0.05, 0.25));
+    assert_eq!(apply_global_alpha(pixel, 0.5, false), (0.4, 0.2, 0.1, 0.25));
+    assert_eq!(apply_global_alpha(pixel, 0.0, true), (0.0, 0.0, 0.0, 0.0));
+}
