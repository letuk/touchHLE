+fn apply_global_alpha(
+    pixel: (CGFloat, CGFloat, CGFloat, CGFloat),
+    alpha: CGFloat,
+    premultiplied: bool,
+) -> (CGFloat, CGFloat, CGFloat, CGFloat) {
+    if premultiplied {
+        (
+            pixel.0 * alpha,
+            pixel.1 * alpha,
+            pixel.2 * alpha,
+            pixel.3 * alpha,
+        )
+    } else {
+        (pixel.0, pixel.1, pixel.2, pixel.3 * alpha)
+    }
+}
+
+#[test]
+fn test_global_alpha() {
+    let pixel = (0.4, 0.2, 0.1, 0.5);
